# Copy to .env.local for the Next.js app:
#     cp .env.example .env.local
#
# docker-compose.yml has these same values as built-in defaults, so the stack
# starts without any .env at all. Create a plain `.env` beside the compose file
# only if you want to override ports or passwords.

# --- Postgres ---------------------------------------------------------------
# Host name is `localhost` from the app and `postgres` from inside pgAdmin.
DATABASE_URL=postgres://multiplayer:localdev@localhost:5432/multiplayer_ai

POSTGRES_USER=multiplayer
POSTGRES_PASSWORD=localdev
POSTGRES_DB=multiplayer_ai
POSTGRES_PORT=5432

# --- Repository context (pgvector + Postgres keyword search) -----------------
# Requires migration 029 and a Postgres server with the vector extension.
# Supply the full embeddings endpoint URL and its model/dimension contract.
# Defaults: free local Ollama + nomic-embed-text (downloaded by Compose).
# Set URL or model to an empty string to disable semantic repo search.
REPO_EMBEDDING_URL=http://localhost:11435/v1/embeddings
REPO_EMBEDDING_MODEL=nomic-embed-text:v1.5
REPO_EMBEDDING_DIMENSIONS=768
# REPO_EMBEDDING_API_KEY=
# Container URL differs from the host URL. Set both for a hosted provider.
# REPO_EMBEDDING_CONTAINER_URL=http://repo-embeddings:11434/v1/embeddings
# REPO_EMBEDDING_PORT=11435
# REPO_LOCAL_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Optional model-specific task prefixes (Nomic defaults are automatic).
# REPO_EMBEDDING_QUERY_PREFIX="search_query: "
# REPO_EMBEDDING_DOCUMENT_PREFIX="search_document: "
# Set the same values in web and worker. Changing them refreshes stored vectors.

# --- Redis ------------------------------------------------------------------
# Unset this to fall back to in-process presence, which needs no server but
# cannot see connections held by another process.
# 6380, because the default 6379 is used by another project on this machine.
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin
PGADMIN_PORT=5050

# --- Mnemosyne (semantic shared memory) -------------------------------------
# Postgres always stores memories, approval state, provenance, and retry jobs.
# Unset MNEMOSYNE_URL to use keyword recall only. Set it to enable optional
# semantic search and queued indexing (the /mcp path is required).
# From the app: http://localhost:8787/mcp; from inside compose: http://mnemosyne:8787/mcp
MNEMOSYNE_URL=http://localhost:8787/mcp
MNEMOSYNE_MCP_TOKEN=localdev-memory-token
MNEMOSYNE_PORT=8787

# --- Memory extraction and review ------------------------------------------
# Run `npm run worker` for durable indexing, extraction, and publication checks.
# Memory jobs need Postgres, not Redis. The room's Memory button lets editors
# create/review facts even without a model. Optional extraction creates proposed
# facts/procedures with exact evidence quotes; an editor must approve them.
# Full OpenAI-compatible chat-completions URL; never a bare /v1 base URL.
# MEMORY_EXTRACTION_URL=http://localhost:4000/v1/chat/completions
# MEMORY_EXTRACTION_MODEL=haiku-4-5
# MEMORY_EXTRACTION_API_KEY=sk-litellm-local
# Compose worker URLs use service names (http://litellm:4000/...), not localhost.
# ANTHROPIC_API_KEY=sk-ant-...   # required when using the bundled LiteLLM proxy
# Keep autonomous sleep disabled: immutable record IDs/revisions must survive
# sidecar search. The app no longer uses MEMORY_CONSOLIDATION or canonical facts.
MNEMOSYNE_AUTO_SLEEP_ENABLED=false

# --- Hosted deployments: users' own runners and AI accounts -----------------
# The Compose app profile sets these explicitly. For a hosted Node deployment,
# set all three and keep REDIS_URL configured. Users pair their own runner and
# sign into their provider on their own machine. An offline runner blocks a
# turn; it never falls back to your server or your provider account.
# LOCAL_RUNNERS=1
# MULTIPLAYER_AI_TERMINAL=0
# AGENT_WORKER=0
# Optional hosted web processes on one shared port (npm run next:start).
# Defaults to 1. Values >1 require the settings above and shared Redis/storage.
# Each process has its own 10-connection database pool and 32 MiB Git read cache.
# WEB_CONCURRENCY=4

# Shared API protection is enabled automatically. Hosted/local-runner mode
# requires Redis; isolated single-process development can use bounded memory.
# Requests use separate read/write/upload/runner budgets; see
# docs/production-deployment.md. Override, for example:
# API_RATE_READ_PER_MINUTE=600
# API_RATE_READ_BURST=120
# API_RATE_WRITE_PER_MINUTE=180
# API_RATE_WRITE_BURST=60
# API_RATE_AUTH_PER_MINUTE=20
# API_RATE_AUTH_BURST=10
# Only behind the supplied private-network gateway (never trust raw XFF):
# API_TRUST_PROXY=1
# PROXY_SHARED_SECRET=  # independently generated, at least 32 characters
# For a fresh hosted deployment use docker/production.env.example instead.

# --- Local development: inline vs. worker -----------------------------------
# Without an online runner, development runs execute inline, which needs no extra
# process. Set AGENT_WORKER=1 to dispatch them to a separate worker instead
# (`npm run worker`, started automatically by ./start.sh), so a runaway CLI
# spikes the worker's CPU, never the web server everyone shares. This requires
# REDIS_URL (the queue and the live-output bridge both use it). Kept explicit —
# not merely "is Redis present" — because REDIS_URL is already set above for
# presence, and you don't want that alone to make a worker mandatory.
# AGENT_WORKER=1
# How many runs one worker process executes at once.
# AGENT_WORKER_CONCURRENCY=2

# --- Session storage --------------------------------------------------------
# Where session repos and records live. Defaults to ./.multiplayer-ai
# When AGENT_WORKER=1, web and worker must resolve this to the SAME git state —
# trivially true on one host; for a containerized worker see docker-compose.yml.
# MULTIPLAYER_AI_DATA=

# Rooms and repository history are never deleted automatically by age.
# Inspect reclaimable caches with `npm run storage:maintain` (dry run by default).

# Public website: HTTPS installer URLs. Rebuild the web app after changing these.
# Empty values show clearly labeled demo links to example.com/downloads/.
DESKTOP_DOWNLOAD_MAC_URL=
DESKTOP_DOWNLOAD_WINDOWS_URL=
DESKTOP_DOWNLOAD_LINUX_URL=

# --- Durable activity and optional cold Git storage -------------------------
# Server disk is the default. No bucket or cloud credentials are required.
STORAGE_PROVIDER=local
# Optional dedicated disk/mount; defaults to <MULTIPLAYER_AI_DATA>/objects.
# STORAGE_LOCAL_DIR=/var/lib/multiplayer-ai/objects
# Optional namespace within either the disk directory or bucket.
# STORAGE_PREFIX=
# To migrate later: copy/verify existing objects before changing provider.
# STORAGE_PROVIDER=s3       # AWS or another S3-compatible service
# STORAGE_BUCKET=
# STORAGE_REGION=us-east-1  # R2: auto; other services: their signing region
# STORAGE_ENDPOINT=        # Custom service endpoint; blank for AWS
# STORAGE_PATH_STYLE=0     # Set 1 for MinIO/path-style endpoints
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_SESSION_TOKEN=
# Without STORAGE_* credentials, use the AWS SDK credential chain (IAM, etc.).
# See docs/workspace-sync.md for provider examples and migration steps.
# Enable on every app/worker replica together; requires shared Redis + Git disk.
# Local archives still consume server disk. Cold caching is optional.
# STORAGE_COLD_GIT=1
# Target idle Git cache size; pinned active repos and scratch may exceed it.
# STORAGE_GIT_CACHE_BYTES=2147483648
