# Copy to .env.local for the Next.js app:
#     cp .env.example .env.local
#
# docker-compose.yml has these same values as built-in defaults, so the stack
# starts without any .env at all. Create a plain `.env` beside the compose file
# only if you want to override ports or passwords.

# --- Postgres ---------------------------------------------------------------
# Host name is `localhost` from the app and `postgres` from inside pgAdmin.
DATABASE_URL=postgres://multiplayer:localdev@localhost:5432/multiplayer_ai

POSTGRES_USER=multiplayer
POSTGRES_PASSWORD=localdev
POSTGRES_DB=multiplayer_ai
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
# Unset this to fall back to in-process presence, which needs no server but
# cannot see connections held by another process.
# 6380, because the default 6379 is used by another project on this machine.
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin
PGADMIN_PORT=5050

# --- Mnemosyne (semantic shared memory) -------------------------------------
# Unset MNEMOSYNE_URL to disable the memory layer entirely: recall and ingest
# are skipped and the app falls back to fork + @room/chat context only. Point it
# at the sidecar's MCP endpoint (the /mcp path is required).
# From the app: http://localhost:8787/mcp; from inside compose: http://mnemosyne:8787/mcp
MNEMOSYNE_URL=http://localhost:8787/mcp
MNEMOSYNE_MCP_TOKEN=localdev-memory-token
MNEMOSYNE_PORT=8787

# --- Memory consolidation (app-driven "sleep") ------------------------------
# Off by default: exchanges are remembered immediately and, if the sidecar's own
# autonomous sleep is on, it consolidates on its own cadence. Set this to 1 to
# instead let the app own the trigger — ingest stages each exchange in Redis and
# (re)arms a BullMQ debounce timer; a worker fires the sidecar's `sleep` once the
# room goes quiet. Needs REDIS_URL and a running worker (npm run worker).
# MEMORY_CONSOLIDATION=1
# MEMORY_CONSOLIDATION_CONCURRENCY=2
#
# When app-driven consolidation is on, disable the sidecar's autonomous pass so
# the two don't both fire, and wire its LLM so `sleep` does real fact extraction
# and conflict resolution (via the LiteLLM proxy → Claude). The `app` compose
# profile reads these:
# MNEMOSYNE_AUTO_SLEEP_ENABLED=false
# MNEMOSYNE_LLM_ENABLED=true
# MNEMOSYNE_LLM_CONFLICT_DETECTION=true
# ANTHROPIC_API_KEY=sk-ant-...   # used by the LiteLLM proxy for consolidation
#
# Steer the sidecar's model-refresh (canonical fact extraction) for a code IDE.
# NOTE the SLEEP_MODEL_REFRESH_ prefix — MNEMOSYNE_SLEEP_CONFLICT_* would be a
# no-op. Facts outside these categories are dropped; conflict thresholds stay
# high so a stray remark can't overwrite an architectural decision (raise, never
# lower, the evidence bar to harden). The app reads these back via recallCanonical.
# MNEMOSYNE_SLEEP_MODEL_REFRESH_CATEGORIES=architecture,convention,techdebt
# MNEMOSYNE_SLEEP_MODEL_REFRESH_CONFLICT_MIN_CONFIDENCE=0.8
# MNEMOSYNE_SLEEP_MODEL_REFRESH_CONFLICT_MIN_EVIDENCE=5

# --- Agent runs: inline vs. worker ------------------------------------------
# By default agent runs execute inline in the web server, which needs no extra
# process. Set AGENT_WORKER=1 to dispatch them to a separate worker instead
# (`npm run worker`, started automatically by ./start.sh), so a runaway CLI
# spikes the worker's CPU, never the web server everyone shares. This requires
# REDIS_URL (the queue and the live-output bridge both use it). Kept explicit —
# not merely "is Redis present" — because REDIS_URL is already set above for
# presence, and you don't want that alone to make a worker mandatory.
# AGENT_WORKER=1
# How many runs one worker process executes at once.
# AGENT_WORKER_CONCURRENCY=2

# --- Session storage --------------------------------------------------------
# Where session repos and records live. Defaults to ./.multiplayer-ai
# When AGENT_WORKER=1, web and worker must resolve this to the SAME git state —
# trivially true on one host; for a containerized worker see docker-compose.yml.
# MULTIPLAYER_AI_DATA=

# Retention thresholds in days. Archive reclaims the working copy only.
# MULTIPLAYER_AI_ARCHIVE_DAYS=7
# MULTIPLAYER_AI_DELETE_DAYS=30
