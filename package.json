{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run runner:pack",
    "dev": "next dev",
    "up": "./start.sh",
    "up:services": "./start.sh services",
    "down": "./start.sh down",
    "prebuild": "npm run runner:pack",
    "build": "next build",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "runner": "tsx runner/index.ts",
    "runner:pack": "node scripts/package-runner.mjs",
    "test:runner-package": "npm run runner:pack && node --test tests/runner-package.test.mjs",
    "start": "npm run desktop:prepare && electron .desktop-build/app --local-server",
    "next:start": "node scripts/serve.mjs",
    "desktop:prepare": "node desktop/prepare.mjs",
    "desktop:attach": "npm run desktop:prepare && electron .desktop-build/app",
    "desktop:prod": "npm run desktop:attach",
    "desktop:pack": "node desktop/package.mjs --dir",
    "desktop:dist": "node desktop/package.mjs",
    "desktop:dist:mac": "node desktop/package.mjs --mac --setup",
    "desktop:dist:win": "node desktop/package.mjs --win --x64 --setup",
    "desktop:dist:linux": "node desktop/package.mjs --linux --x64 --setup",
    "desktop:release": "node desktop/package.mjs --release",
    "test:workspace-ui": "node tests/project-repositories.browser.mjs --start-server && node tests/parallel-chats.browser.mjs --start-server",
    "test:rate-limit": "node --import tsx --test tests/rate-limit.test.mjs tests/rate-limit-clients.test.mjs",
    "test:team-context": "node --import tsx --test tests/team-context.test.mjs",
    "test:team-context:http": "node --import tsx tests/team-context-http.mjs",
    "test:deployment": "node --import tsx tests/deployment-integration.mjs",
    "test:ui": "node tests/chat-ui.browser.mjs --start-server",
    "test:auth-ui": "node tests/auth-ui.browser.mjs --start-server",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "test:server": "node --test tests/server-lifecycle.test.mjs",
    "test:desktop:smoke": "npm run desktop:prepare && node tests/desktop-smoke.mjs",
    "lint": "eslint",
    "db:migrate": "node db/migrate.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "db:test": "node db/schema.test.mjs",
    "test:presence": "tsc app/lib/presence/types.ts app/lib/presence/memory.ts app/lib/presence/redis.ts --outDir .test-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck && node tests/presence.test.cjs",
    "test:repo": "tsc app/lib/session/repo.ts --outDir .test-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck && node tests/repo.test.cjs && npm run test:folder-upload",
    "test:folder-upload": "node --import tsx --test tests/folder-upload.test.mjs",
    "bench:folder-upload": "node --import tsx scripts/benchmark-folder-upload.mjs",
    "test:lock": "node --import tsx --test tests/lock.test.mjs",
    "test:prompt": "tsc app/lib/ai/prompt.ts --outDir .test-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck && node tests/prompt.test.cjs",
    "test:knowledge": "tsc app/lib/knowledge/graph.ts app/lib/knowledge/router.ts --outDir .test-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck && node tests/knowledge.test.cjs",
    "test:room-chat": "node --import tsx tests/room-chat.test.mjs",
    "test:stream": "tsc app/lib/ai/stream.ts --outDir .test-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck && node tests/stream.test.cjs",
    "test:models": "node --import tsx tests/models.test.mjs",
    "test:tasks": "node --import tsx tests/tasks.test.mjs",
    "test:handoff": "node --import tsx tests/handoff.test.mjs",
    "test:parallel-chats": "node --import tsx tests/parallel-chats.test.mjs",
    "test:titles": "node --import tsx tests/titles.test.mjs",
    "test:terminal": "node --import tsx --test tests/terminal.test.mjs tests/agent-execution.test.mjs tests/runner-terminal.test.mjs && node --import tsx tests/terminal-relay.test.mjs",
    "test:reset": "node --import tsx --test tests/reset-data.test.mjs",
    "test:runner-workspaces": "npm run test:runner-package && node --import tsx --test tests/runner-workspaces.test.mjs",
    "test": "npm run db:test && npm run test:presence && npm run test:repo && npm run test:project-repositories && npm run test:lock && npm run test:prompt && npm run test:knowledge && npm run test:repo-context && npm run test:room-chat && npm run test:tasks && npm run test:memory && npm run test:stream && npm run test:handoff && npm run test:parallel-chats && npm run test:titles && npm run test:terminal && npm run test:recovery && npm run test:runner-workspaces && npm run test:models && npm run test:storage && npm run test:load:unit && npm run test:performance && npm run test:live-chat && npm run test:chat-access && npm run test:usage && npm run test:admission && npm run test:release-preflight && npm run test:clerk && npm run test:sharing && npm run test:collaboration",
    "test:memory": "node --import tsx tests/memory.test.mjs",
    "eval:memory": "node --import tsx scripts/eval-memory.mjs",
    "memory:reindex": "node scripts/reindex-memory.mjs",
    "test:repo-context": "node --import tsx tests/repo-context.test.mjs",
    "test:repo-context:live": "node --import tsx tests/repo-context-live.test.mjs",
    "test:project-repositories": "node --import tsx tests/project-repositories.test.mjs",
    "storage:maintain": "node --import tsx scripts/storage-maintenance.ts",
    "storage:accounting": "node --import tsx scripts/storage-accounting.ts",
    "bench:storage": "node --import tsx scripts/benchmark-storage-admission.mjs",
    "test:storage": "node --import tsx --test tests/storage.test.mjs",
    "test:load": "node --import tsx tests/load/run.mjs",
    "test:load:unit": "node --test tests/load/core.test.mjs tests/load/cancellation.test.mjs tests/load/resources.test.mjs",
    "test:performance": "node --import tsx tests/session-token.test.mjs && node --import tsx tests/room-access-parity.test.mjs && node --import tsx --test tests/git-read-cache.test.mjs tests/server-config.test.mjs && npm run test:rate-limit",
    "bench:runtime:build": "node benchmarks/runtime/build.mjs",
    "bench:runtime:test": "node --import tsx --test benchmarks/runtime/compute.test.mjs && cd benchmarks/runtime/go && go test -race ./...",
    "bench:runtime": "node --import tsx benchmarks/runtime/compare.mjs",
    "test:live-chat": "node --import tsx --test tests/live-chat.test.mjs",
    "test:chat-access": "node --import tsx tests/chat-access.test.mjs",
    "test:usage": "node --import tsx tests/usage.test.mjs && node tests/optional-caps-migration.test.mjs",
    "test:architecture:postgres": "node --import tsx tests/architecture-postgres.test.mjs",
    "test:docker-context": "node --test tests/docker-context.test.mjs",
    "test:integration": "node --import tsx tests/handoff-integration.mjs",
    "test:recovery": "node --import tsx --test tests/recovery.test.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:restore": "node scripts/backup.mjs restore",
    "backup:restore-config": "node scripts/backup.mjs restore-config",
    "test:backup": "node tests/backup-restore.mjs",
    "beta:invite": "tsx scripts/invite-beta.ts",
    "test:admission": "node --import tsx --test tests/signup-admission.test.mjs tests/storage-admission.test.mjs tests/receive-budget.test.mjs tests/invite-beta-cli.test.mjs tests/invitation-link.test.mjs tests/public-origin.test.mjs",
    "desktop:preflight": "node desktop/release-preflight.mjs",
    "test:release-preflight": "node --test tests/release-preflight.test.mjs",
    "test:signup:http": "node --import tsx tests/clerk-auth-http.mjs --invite",
    "test:invitations:http": "node --import tsx tests/invitations-http.mjs",
    "test:google-auth": "node --import tsx --test tests/google-auth.test.mjs",
    "test:email-verification": "node --import tsx --test tests/email-verification.test.mjs tests/auth-request.test.mjs",
    "test:email-sender": "node --import tsx tests/email-sender-live.mjs",
    "test:email-verification:http": "npm run test:clerk:http",
    "test:google-auth:http": "npm run test:clerk:http",
    "test:sharing": "node --import tsx tests/shared-chats.test.mjs && node --import tsx --test tests/db-limits.test.mjs",
    "test:sharing:http": "node --import tsx tests/shared-chats-http.mjs",
    "test:collaboration": "node --import tsx tests/collaboration-flow.test.mjs",
    "docs:capture": "npm run desktop:prepare && node scripts/capture-docs.mjs --start-server",
    "test:docs": "node --import tsx --test tests/docs.test.mjs && node --import tsx tests/docs.browser.mjs --start-server",
    "test:clerk": "node --import tsx --test tests/clerk-auth.test.mjs tests/auth-request.test.mjs",
    "test:clerk:http": "node --import tsx tests/clerk-auth-http.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@clerk/nextjs": "^7.9.12",
    "@next/env": "16.3.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bullmq": "^5.34.0",
    "discord.js": "^14.27.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "redis": "^6.2.1",
    "remark-gfm": "^4.0.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "undici": "^7.30.0"
  }
}
