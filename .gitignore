# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.load-test-results/

# next.js
/.next/
/.next-handoff-test/
/out/

# production
/build
/.desktop-build/
/desktop-dist/

# session repos and records (override with MULTIPLAYER_AI_DATA)
/.multiplayer-ai/

# compiled output for the presence tests
/.test-build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and belongs in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.pdf
PROJECT_GUIDE.md
*.txt
*.mp3
*.mp4
artifacts/*

# Private local drafts
/docs/*.local.md
