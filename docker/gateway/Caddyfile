{
    email {$ACME_EMAIL}
    admin off
    servers {
        # Rate limiting requires a verified client address. QUIC early data
        # can arrive before that address is available and cause false 403s.
        0rtt off
    }
}

{$APP_DOMAIN} {
    # Only the balancer and container health checks use readiness. Application
    # responses retain their own private/no-store policy; no API response cache.
    handle /health/* {
        respond 404
    }

    request_body {
        max_size 300MB
    }

    # Only verified public installers belong in this read-only directory.
    # Caddy serves large files and Range requests without occupying a web worker.
    handle_path /downloads/desktop/* {
        root * /srv/desktop-downloads
        header X-Content-Type-Options nosniff
        header {
            Content-Disposition attachment
            Cache-Control "public, max-age=31536000, immutable"
            match status 200 206 304
        }
        file_server
    }

    handle {
      reverse_proxy {$APP_UPSTREAMS:web:3000 web2:3000} {
        lb_policy least_conn
        health_uri /health/ready
        health_interval 10s
        health_timeout 3s
        health_status 200
        fail_duration 10s
        max_fails 2

        # Never replay a mutation after an uncertain upstream outcome.
        lb_retries 0
        lb_try_duration 0

        # Overwrite, never append or trust values supplied by an Internet client.
        header_up X-Multiplayer-Client-IP {http.request.remote.host}
        header_up X-Multiplayer-Proxy-Secret {$PROXY_SHARED_SECRET}
        transport http {
            # Below the application's 70-second upstream idle timeout.
            keepalive 30s
        }
        # Caddy flushes text/event-stream immediately. Leave request/response
        # buffering disabled so uploads and Git packs stream through unchanged.
      }
    }
}
