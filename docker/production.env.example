# Copy to .env.production at the repository root. Never commit real secrets.
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
APP_VERSION=local
POSTGRES_USER=multiplayer
POSTGRES_DB=multiplayer_ai
# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
PROXY_SHARED_SECRET=
MNEMOSYNE_MCP_TOKEN=

# Public HTTPS origin for invitation links and sign-in. Match APP_DOMAIN above.
AUTH_PUBLIC_URL=
# Optional Google login/signup; see docs/google-sign-in.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public HTTPS installer URLs, injected at image BUILD time. Blank = Coming soon.
# MAC_URL is Apple Silicon; MAC_INTEL_URL is Intel.
DESKTOP_DOWNLOAD_MAC_URL=
DESKTOP_DOWNLOAD_MAC_INTEL_URL=
DESKTOP_DOWNLOAD_WINDOWS_URL=
DESKTOP_DOWNLOAD_LINUX_URL=
DESKTOP_DOWNLOAD_CHECKSUMS_URL=
DESKTOP_DOWNLOAD_CHANNEL=preview
# Only verified public binaries/checksums, no secrets or symlinks. Mounted read-only.
# Use immutable, versioned subdirectories; URLs are /downloads/desktop/<version>/<file>.
DESKTOP_DOWNLOADS_DIR=./desktop-dist/published

# Optional overrides, applied identically to both web instances. See
# docs/production-deployment.md for all budgets. These are token buckets:
# sustained requests/minute plus an independently configurable initial burst.
API_RATE_READ_PER_MINUTE=600
API_RATE_READ_BURST=120
API_RATE_WRITE_PER_MINUTE=180
API_RATE_WRITE_BURST=60
API_RATE_AUTH_PER_MINUTE=20
API_RATE_AUTH_BURST=10

# Optional memory extraction service (full /v1/chat/completions endpoint).
MEMORY_EXTRACTION_URL=
MEMORY_EXTRACTION_MODEL=
MEMORY_EXTRACTION_API_KEY=
# Optional read-only Slack/Discord context. The public URL must be an HTTPS
# origin, for example https://app.example.com. See docs/team-context-connections.md.
INTEGRATIONS_PUBLIC_URL=
INTEGRATIONS_ENCRYPTION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
TEAM_CONTEXT_BACKEND=postgres
TEAM_CONTEXT_RETENTION_DAYS=30
